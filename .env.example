# ── Browser (exposed to the client bundle; safe to publish) ──────────────────
# Supabase → Project Settings → API (or Connect). Publishable key (sb_publishable_…)
# or the legacy "anon" key both work.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ── Local scripts and DB tests only (NEVER prefix with VITE_, never commit) ─
# Secret key (sb_secret_…) or legacy service_role key. Used by seed script + RLS tests.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Supabase → Connect → "Session pooler" URI (IPv4-compatible). Used by `npm run db:push`.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Password assigned to the two reviewer accounts created by `npm run seed:reviewers`.
REVIEWER_PASSWORD=choose-a-strong-password
